# Docker Compose project
COMPOSE_PROJECT_NAME=propel
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend map tiles (compiled into the Vite bundle during the Docker build)
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# PostgreSQL development credentials
POSTGRES_DB=propel
POSTGRES_USER=propel
POSTGRES_PASSWORD=propel
DATABASE_URL=postgresql+psycopg://propel:propel@database:5432/propel

# Redis
REDIS_URL=redis://redis:6379/0

# Backend dependency behavior
DEPENDENCY_TIMEOUT_SECONDS=2
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=5

# Telemetry ingestion
TELEMETRY_STREAM_NAME=propel:telemetry
TELEMETRY_REQUEST_TIMEOUT_SECONDS=2
TELEMETRY_MAX_REQUEST_BYTES=16384

# Telemetry worker
TELEMETRY_CONSUMER_GROUP=propel-telemetry-workers
TELEMETRY_CONSUMER_NAME=telemetry-worker-1
TELEMETRY_CONSUMER_BATCH_SIZE=50
TELEMETRY_CONSUMER_BLOCK_MS=1000
TELEMETRY_PENDING_IDLE_MS=5000
TELEMETRY_MAX_DELIVERIES=3
TELEMETRY_DEAD_LETTER_STREAM_NAME=propel:telemetry:dead-letter
ANALYSIS_DUE_SET_NAME=propel:analysis:due
ANALYSIS_DEBOUNCE_SECONDS=10
ANALYSIS_LIVE_FRESHNESS_SECONDS=1920
ANALYSIS_RETRY_DELAY_SECONDS=5
WORKER_RETRY_DELAY_SECONDS=1

# Restoration verification
RESTORATION_THRESHOLD=0.8
RESTORATION_STABILIZATION_SECONDS=10

# Simulator (development-only control surface)
SIMULATOR_TELEMETRY_URL=http://127.0.0.1:8000/api/telemetry
SIMULATOR_REQUEST_TIMEOUT_SECONDS=3
SIMULATOR_ENABLED=true
